{
  "name": "@originchain-db/mcp-server",
  "version": "0.4.0",
  "mcpName": "io.github.originchaindb/mcp-server",
  "description": "Model Context Protocol (MCP) server for OriginChain \u2014 exposes SQL, read-only graph, vector, full-text, and schema tools to Claude Desktop, Cursor, and any MCP-aware AI IDE.",
  "license": "MIT",
  "type": "module",
  "main": "dist/index.js",
  "bin": {
    "originchain-mcp": "dist/index.js"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsc",
    "start": "node dist/index.js",
    "test": "npm run build && node --test test/*.test.mjs",
    "check:server-json": "node scripts/server-json.mjs",
    "install-links": "node scripts/install-links.mjs"
  },
  "engines": {
    "node": ">=20"
  },
  "keywords": [
    "mcp",
    "model-context-protocol",
    "originchain",
    "ai",
    "claude",
    "cursor",
    "database",
    "vector",
    "sql",
    "graph",
    "cypher",
    "full-text-search"
  ],
  "homepage": "https://github.com/originchaindb/mcp-server#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/originchaindb/mcp-server.git"
  },
  "bugs": {
    "url": "https://github.com/originchaindb/mcp-server/issues"
  },
  "author": "Silicoyn Technologies Pvt Ltd",
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.32.2"
  },
  "devDependencies": {
    "@types/node": "^20.12.0",
    "ajv": "^8.20.0",
    "ajv-formats": "^3.0.1",
    "typescript": "^5.5.0"
  }
}
